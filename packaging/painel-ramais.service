[Unit]
Description=Painel de Ramais (coletor AMI)
After=network-online.target painel-ramais.socket
Wants=network-online.target
Requires=painel-ramais.socket
StartLimitIntervalSec=0
# Sem Requires/After de asterisk ou httpd: restart deles nao derruba o painel (o daemon reconecta).

[Service]
Type=simple
User=painel-ramais
Group=painel-ramais
ExecStart=/usr/bin/painel-ramais serve --config /etc/painel-ramais/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
# exit 4 = Asterisk anterior ao 13 (versao sem suporte): reiniciar nao adianta
RestartPreventExitStatus=4
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/painel-ramais
# /run/painel-ramais (0750) so para o metrics.json (memoria do daemon, lido por instalar.py status); sem porta nem socket
RuntimeDirectory=painel-ramais
RuntimeDirectoryMode=0750
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# bloqueia ptrace/process_vm_*/perf_event_open (@debug); systemd 239 (Rocky 8) ja suporta o grupo
SystemCallFilter=~@debug
UMask=0077

[Install]
WantedBy=multi-user.target
