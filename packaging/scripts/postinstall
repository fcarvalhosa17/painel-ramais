#!/bin/sh
# painel-ramais %post. $1 (rpm): 1 = instalacao nova, 2 = upgrade. Idempotente.
# Nunca falha o rpm: cada passo registra o resultado; ausencia de asterisk/httpd/systemd vira aviso.
# (ADR-003: segredos, bloco AMI, conf do Apache, SELinux, systemd.)

CONF_DIR=/etc/painel-ramais
CONFIG=$CONF_DIR/config.yaml
MANAGER_CUSTOM=/etc/asterisk/manager_custom.conf
MANAGER_CONF=/etc/asterisk/manager.conf
HTTPD_CONF=/etc/httpd/conf.d/painel-ramais.conf
HTTPD_TMPL=/usr/share/painel-ramais/httpd.conf.tmpl
ISSABEL_KEY=/etc/painel-ramais-issabel.key
MENU_XML=/usr/share/painel-ramais/issabel/menu.xml
SVC=painel-ramais
DEFAULT_PORT=8790
BEGIN_MARK='; BEGIN painel-ramais'
END_MARK='; END painel-ramais'

log()  { echo "painel-ramais: $*"; command -v logger >/dev/null 2>&1 && logger -t painel-ramais-rpm "$*"; return 0; }
warn() { echo "painel-ramais: AVISO: $*" >&2; command -v logger >/dev/null 2>&1 && logger -t painel-ramais-rpm "AVISO: $*"; return 0; }

# systemd so conta se for o init em execucao (container/chroot pode ter o binario systemctl sem systemd rodando)
HAVE_SYSTEMD=
[ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1 && HAVE_SYSTEMD=1

# --- segredo HMAC (base64 de 32 bytes) e senha AMI (hex de 32 bytes): so se nao existirem ---
if [ ! -s "$CONF_DIR/secret" ]; then
  ( umask 077; head -c 32 /dev/urandom | base64 -w0 > "$CONF_DIR/secret" )
  log "secret HMAC gerado"
fi
if [ ! -s "$CONF_DIR/ami-secret" ]; then
  ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$CONF_DIR/ami-secret" )
  log "senha AMI gerada"
fi
chown painel-ramais:painel-ramais "$CONF_DIR/secret" "$CONF_DIR/ami-secret"
chmod 0600 "$CONF_DIR/secret" "$CONF_DIR/ami-secret"

# NOTA: os eventos Reload, ModuleLoadReport e FullyBooted (reloadEvents no supervisor do daemon) disparam a releitura dos ramais (decisao 4). Desde a rc.7
# o Shutdown (Asterisk desligando) tambem entra no eventfilter: o daemon abre a janela de evento do sistema do relatorio de registro (ADR-007). Confirmar no Asterisk real se `read = system,call`
# entrega o Reload (docs/ROTEIRO-CAPTURA.md, item 12); se nao entregar, a rede de seguranca e o ami.inventory_refresh (padrao 10 min).
# rc.8 (ADR-008): os onze eventos de fila e agente (QueueCallerJoin, QueueCallerLeave, QueueCallerAbandon, QueueMemberStatus, QueueMemberPause,
# QueueMemberAdded, QueueMemberRemoved, AgentCalled, AgentConnect, AgentComplete, AgentRingNoAnswer) sao da classe de leitura `agent`: por isso
# `read = system,call,agent`. So leitura (a classe `write` nao muda); alimentam a aba Chamadas e o painel de filas. AgentCalled e AgentRingNoAnswer
# entram no filtro mas o daemon os descarta nesta versao. Mesma regra do bloco: so aqui, entre os marcadores, nunca em manager.conf.
# --- bloco AMI em manager_custom.conf (nunca manager.conf) ---
ami_block() {
  cat <<AMIEOF
$BEGIN_MARK
; Gerado pelo pacote painel-ramais. Nao editar: o upgrade reescreve este bloco.
[painel-ramais]
secret = $(cat "$CONF_DIR/ami-secret")
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.255
read = system,call,agent
write = system,reporting
writetimeout = 5000
displayconnects = no
eventfilter = Event: ContactStatus
eventfilter = Event: PeerStatus
eventfilter = Event: DeviceStateChange
eventfilter = Event: Newchannel
eventfilter = Event: Newstate
eventfilter = Event: NewCallerid
eventfilter = Event: NewConnectedLine
eventfilter = Event: DialBegin
eventfilter = Event: DialEnd
eventfilter = Event: BridgeEnter
eventfilter = Event: BridgeLeave
eventfilter = Event: Hangup
eventfilter = Event: Hold
eventfilter = Event: Unhold
eventfilter = Event: Reload
eventfilter = Event: ModuleLoadReport
eventfilter = Event: FullyBooted
eventfilter = Event: Shutdown
eventfilter = Event: QueueCallerJoin
eventfilter = Event: QueueCallerLeave
eventfilter = Event: QueueCallerAbandon
eventfilter = Event: QueueMemberStatus
eventfilter = Event: QueueMemberPause
eventfilter = Event: QueueMemberAdded
eventfilter = Event: QueueMemberRemoved
eventfilter = Event: AgentCalled
eventfilter = Event: AgentConnect
eventfilter = Event: AgentComplete
eventfilter = Event: AgentRingNoAnswer
$END_MARK
AMIEOF
}

# Seguranca: /etc/asterisk e do usuario asterisk, que poderia plantar symlink. Por isso a montagem fica em /run
# (so root) e TODA leitura/escrita no manager_custom.conf roda COMO o usuario asterisk (um symlink so alcanca o
# que o proprio asterisk ja alcanca). Nada e gravado fora de /etc/asterisk.
as_asterisk() { runuser -u asterisk -- "$@"; }

if [ -d /etc/asterisk ] && command -v runuser >/dev/null 2>&1 && getent passwd asterisk >/dev/null 2>&1; then
  TMPD=$(mktemp -d /run/painel-ramais-post.XXXXXX 2>/dev/null)
  if [ -z "$TMPD" ]; then
    warn "mktemp em /run falhou; bloco AMI nao configurado"
  else
    chmod 0700 "$TMPD"
    if [ -e "$MANAGER_CUSTOM" ] || [ -L "$MANAGER_CUSTOM" ]; then
      as_asterisk cat "$MANAGER_CUSTOM" > "$TMPD/orig" 2>/dev/null || : > "$TMPD/orig.falhou"
    else
      : > "$TMPD/orig"
    fi
    if [ -e "$TMPD/orig.falhou" ]; then
      warn "usuario asterisk nao consegue ler $MANAGER_CUSTOM; bloco AMI nao configurado"
    else
      sed "/^$BEGIN_MARK/,/^$END_MARK/d" "$TMPD/orig" > "$TMPD/sem-bloco"
      sed -n "/^$BEGIN_MARK/,/^$END_MARK/p" "$TMPD/orig" > "$TMPD/atual"
      ami_block > "$TMPD/novo"
      if grep -q '^\[painel-ramais\]' "$TMPD/sem-bloco"; then
        warn "secao [painel-ramais] existe em $MANAGER_CUSTOM fora dos marcadores; nao alterei (conflito com configuracao manual)"
      elif ! cmp -s "$TMPD/atual" "$TMPD/novo"; then
        { cat "$TMPD/sem-bloco"; echo; cat "$TMPD/novo"; } > "$TMPD/final"
        # escrita no lugar (mantem dono, modo e contexto SELinux); arquivo novo nasce asterisk:asterisk 0640
        if as_asterisk sh -c 'umask 027; cat > "$1"' sh "$MANAGER_CUSTOM" < "$TMPD/final"; then
          log "bloco AMI gravado em $MANAGER_CUSTOM"
          as_asterisk chmod o-rwx "$MANAGER_CUSTOM" || warn "nao consegui aplicar chmod o-rwx em $MANAGER_CUSTOM; ajuste manualmente (contem a senha AMI)"
          command -v restorecon >/dev/null 2>&1 && restorecon "$MANAGER_CUSTOM" 2>/dev/null
          if command -v asterisk >/dev/null 2>&1; then
            asterisk -rx "manager reload" >/dev/null 2>&1 || warn "manager reload falhou (Asterisk parado?); vale na proxima subida"
          else
            warn "asterisk nao encontrado; manager reload nao executado"
          fi
        else
          # a gravacao no lugar pode ter truncado o arquivo: $TMPD/orig e a unica copia do original, NAO apagar
          KEEP_TMPD=1
          warn "nao consegui gravar $MANAGER_CUSTOM como usuario asterisk. O original esta salvo em $TMPD/orig (restaure com: cp $TMPD/orig $MANAGER_CUSTOM). ATENCAO: $TMPD fica em /run (tmpfs) e some no reinicio; COPIE o arquivo para outro lugar antes de reiniciar o servidor"
        fi
      else
        as_asterisk chmod o-rwx "$MANAGER_CUSTOM" 2>/dev/null
        log "bloco AMI ja atualizado"
      fi
    fi
    [ -n "$KEEP_TMPD" ] || rm -rf "$TMPD"
  fi
  grep -q 'manager_custom.conf' "$MANAGER_CONF" 2>/dev/null || warn "$MANAGER_CONF nao inclui manager_custom.conf; o usuario AMI nao sera carregado"
else
  warn "/etc/asterisk, runuser ou usuario asterisk ausente; usuario AMI nao configurado"
fi

# porta/host de listen: (usados pelo Apache e pelo socket systemd)
LISTEN=$(awk '/^listen:/ { v=$0; sub(/^listen:[ \t]*/, "", v); sub(/[ \t]*#.*$/, "", v); gsub(/\042|\047/, "", v); print v; exit }' "$CONFIG" 2>/dev/null)
PORT=${LISTEN##*:}
HOST=${LISTEN%:*}
case "$PORT" in ''|*[!0-9]*) warn "nao entendi 'listen:' em $CONFIG ('$LISTEN'); usando 127.0.0.1:$DEFAULT_PORT"; PORT=$DEFAULT_PORT; HOST=127.0.0.1 ;; esac
[ -n "$HOST" ] && [ "$HOST" != "$LISTEN" ] || HOST=127.0.0.1

# --- Apache: arquivo proprio, validado antes do reload ---
if command -v httpd >/dev/null 2>&1 && [ -d /etc/httpd/conf.d ] && [ -f "$HTTPD_TMPL" ]; then
  rm -f "$HTTPD_CONF"
  if ! OUT=$(httpd -t 2>&1); then
    warn "configuracao do Apache ja estava invalida; conf do painel nao instalada. Saida: $OUT"
  else
    sed -e "s/@HOST@/$HOST/g" -e "s/@PORT@/$PORT/g" "$HTTPD_TMPL" > "$HTTPD_CONF"
    chmod 0644 "$HTTPD_CONF"
    if ! OUT=$(httpd -t 2>&1); then
      rm -f "$HTTPD_CONF"
      warn "httpd -t falhou; $HTTPD_CONF removido e httpd NAO recarregado. Saida: $OUT"
    elif ! httpd -M 2>&1 | grep -q proxy_wstunnel_module; then
      rm -f "$HTTPD_CONF"
      warn "mod_proxy_wstunnel nao carregado; $HTTPD_CONF removido e httpd NAO recarregado"
    elif [ -n "$HAVE_SYSTEMD" ] && systemctl is-active --quiet httpd; then
      if systemctl reload httpd; then log "proxy Apache ativo em /painel-ramais/ (porta $PORT)"; else warn "systemctl reload httpd falhou"; fi
    else
      log "$HTTPD_CONF gravado; httpd inativo, sera lido na proxima subida"
    fi
  fi
else
  warn "httpd ou modelo da conf ausente; proxy Apache nao configurado"
fi

# --- socket do systemd: ListenStream fixo em 127.0.0.1:8790; se o listen: do config for outro, usa drop-in ---
SOCK_DROPIN=/etc/systemd/system/painel-ramais.socket.d
if [ "$HOST:$PORT" != "127.0.0.1:$DEFAULT_PORT" ] && [ -n "$PORT" ]; then
  mkdir -p "$SOCK_DROPIN" && printf '[Socket]\nListenStream=\nListenStream=%s:%s\n' "$HOST" "$PORT" > "$SOCK_DROPIN/listen.conf" \
    && log "socket systemd ajustado para $HOST:$PORT (drop-in $SOCK_DROPIN/listen.conf)"
else
  rm -rf "$SOCK_DROPIN"
fi

# --- SELinux ---
if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" = "Enforcing" ]; then
  if [ "$(getsebool httpd_can_network_connect 2>/dev/null | awk '{print $3}')" != "on" ]; then
    if setsebool -P httpd_can_network_connect 1; then
      log "SELinux enforcing: httpd_can_network_connect ativado"
    else
      warn "setsebool -P httpd_can_network_connect 1 falhou"
    fi
  fi
fi

# --- chave do Issabel (assina o token do modulo PHP): so se nao existir; conteudo existente nunca e tocado ---
if [ ! -s "$ISSABEL_KEY" ]; then
  KEYTMP=$(mktemp /etc/.painel-ramais-issabel.key.XXXXXX 2>/dev/null)
  if [ -z "$KEYTMP" ]; then
    warn "mktemp em /etc falhou; chave do Issabel nao gerada"
  else
    ( umask 077; head -c 32 /dev/urandom | base64 -w0 > "$KEYTMP" )
    # chave igual ao segredo do daemon (probabilidade nula, mas barato): gera de novo
    if cmp -s "$KEYTMP" "$CONF_DIR/secret"; then
      ( umask 077; head -c 32 /dev/urandom | base64 -w0 > "$KEYTMP" )
    fi
    if mv -f "$KEYTMP" "$ISSABEL_KEY"; then log "chave do Issabel gerada em $ISSABEL_KEY"; else rm -f "$KEYTMP"; warn "nao consegui gravar $ISSABEL_KEY"; fi
  fi
fi
if [ -f "$ISSABEL_KEY" ]; then
  if getent group asterisk >/dev/null 2>&1; then
    chown painel-ramais:asterisk "$ISSABEL_KEY"
    chmod 0640 "$ISSABEL_KEY"
  else
    chown painel-ramais:painel-ramais "$ISSABEL_KEY"
    chmod 0600 "$ISSABEL_KEY"
    warn "grupo asterisk ausente: chave do Issabel 0600; integracao com o menu desligada"
  fi
  command -v restorecon >/dev/null 2>&1 && restorecon "$ISSABEL_KEY" 2>/dev/null
fi

# --- item do menu do Issabel: so registra o NOSSO item (menu.xml); o menumerge nunca altera as permissoes de item que ja existe ---
if [ -x /usr/bin/issabel-menumerge ] && [ -f "$MENU_XML" ]; then
  if /usr/bin/issabel-menumerge "$MENU_XML" >/dev/null 2>&1; then
    log "item painel_ramais registrado no menu do Issabel"
  else
    warn "issabel-menumerge falhou; rode ./instalar.py menu"
  fi
else
  warn "issabel-menumerge ausente; item do menu nao registrado (rode ./instalar.py menu depois)"
fi

# --- systemd ---
if [ -n "$HAVE_SYSTEMD" ]; then
  systemctl daemon-reload
  # o .socket segura a porta; o .service (Requires=socket) coleta do AMI mesmo sem conexoes HTTP
  systemctl enable "$SVC.socket" "$SVC.service" >/dev/null 2>&1
  if [ "${1:-1}" = "2" ]; then
    systemctl start "$SVC.socket" || warn "start do $SVC.socket falhou; ver 'journalctl -u $SVC.socket'"
    systemctl try-restart "$SVC.service" || warn "restart do $SVC falhou; ver 'journalctl -u $SVC'"
  else
    systemctl start "$SVC.socket" || warn "start do $SVC.socket falhou; ver 'journalctl -u $SVC.socket'"
    systemctl start "$SVC.service" || warn "start do $SVC falhou; ver 'journalctl -u $SVC'"
  fi
else
  warn "systemd nao esta em execucao (sem /run/systemd/system ou sem systemctl, ex.: container); servico nao habilitado nem iniciado. Instalacao do pacote segue normal; em um host real: systemctl enable --now painel-ramais.socket painel-ramais.service"
fi

exit 0
