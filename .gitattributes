# Fim de linha LF em tudo que e texto (CRLF quebra script no Rocky).
* text=auto eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.socket    text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.example   text eol=lf
Makefile    text eol=lf
packaging/scripts/* text eol=lf

*.png  binary
*.jpg  binary
*.gz   binary
*.rpm  binary
*.db   binary

# fontes e licencas embutidas: bytes exatos do upstream (SHA256 em ORIGEM.txt)
internal/web/static/assets/fonts/* binary
