# Fim de linha LF em tudo que e texto (CRLF quebra script no Rocky).
* text=auto eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.socket    text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.example   text eol=lf
Makefile    text eol=lf
packaging/scripts/* text eol=lf

*.png  binary
*.jpg  binary
*.gz   binary
*.rpm  binary
*.db   binary

# capturas de AMI: CRLF e tamanho exato por quadro; o git nao pode normalizar
testdata/capturas/*.txt binary
